# config.env.example — образец настроек. Скопируйте в config.env и заполните.
#   cp config.env.example config.env && chmod 600 config.env
# config.env в .gitignore и в репозиторий не попадает (там пароль FTP).

# --- Скачивание ---
START_DATE="2025-01-01"                 # с какой даты качать (включительно). Смена НЕ удаляет старые файлы.
# ARCHIVE_DIR="/etc/astra/upd"          # куда складывать сборки (по умолчанию: ./archive рядом со скриптом)
# STATE_DIR="/opt/astra-backup/state"   # служебные файлы (по умолчанию: ./state рядом со скриптом)
RECHECK_DAYS=45                          # перепроверять «отсутствующие» даты за последние N дней
REQUEST_DELAY=0                          # пауза между запросами, сек (0.2 — щадящий режим)

# --- FTP выгрузка ---
FTP_HOST=""                              # напр. ftp.example.com
FTP_PORT=21                              # 21 обычный; 990 — неявный FTPS (см. README)
FTP_USER=""
FTP_PASS=""                              # хранится в открытом виде — сделайте chmod 600 config.env
FTP_DIR="/astra"                         # каталог назначения на сервере
FTP_TLS=0                                # 1 = FTPS explicit (AUTH TLS)
